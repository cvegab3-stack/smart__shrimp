# Configuración para docker-compose.yml. Copia este archivo a .env.docker (no se sube a Git) y completa los valores.
# Genera claves largas, p. ej.: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
# Nombres o IP con los que se abrirá la aplicación, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 1 = HTTPS (docker-compose.https.yml con certificado). 0 = HTTP, solo para probar en una red local de confianza.
DJANGO_HTTPS=0
# Solo si se accede por un origen distinto al del Host (p. ej. otro puerto): https://mi-dominio:8443
DJANGO_CSRF_TRUSTED_ORIGINS=
# 0 = no migrar al arrancar (con varias réplicas, migrar una sola vez a mano).
DJANGO_MIGRATE_ON_START=1

# --- Sesión y contraseñas ---
SESSION_IDLE_MINUTES=30
SESSION_WARNING_SECONDS=120
PASSWORD_MIN_LENGTH=8

# --- PostgreSQL (los usan tanto el contenedor db como Django) ---
POSTGRES_DB=smart_shrimp
POSTGRES_USER=smart_shrimp
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Servicio de visión (red interna de Docker) ---
VISION_SERVICE_URL=http://vision:8001
# El mismo secreto en Django y en visión.
VISION_SERVICE_TOKEN_SECRET=
VISION_TIMEOUT_SECONDS=5
VISION_MAX_RETRIES=1
# Vacío = modelo incluido en la imagen (models/detector/best.pt).
DETECTOR_WEIGHTS=
