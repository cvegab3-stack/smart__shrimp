# Configuración local de desarrollo (SQLite, no requiere PostgreSQL).
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local
VISION_SERVICE_URL=http://127.0.0.1:8001
VISION_SERVICE_TOKEN_SECRET=cambia-este-secreto-compartido-django-vision
VISION_TIMEOUT_SECONDS=5
VISION_MAX_RETRIES=1

# Sesión: se cierra tras estos minutos sin actividad; la página avisa SESSION_WARNING_SECONDS antes.
SESSION_IDLE_MINUTES=30
SESSION_WARNING_SECONDS=120
# Longitud mínima de las contraseñas nuevas (además: no comunes, no solo números, no parecidas a los datos).
PASSWORD_MIN_LENGTH=8

# Modelo del detector. Vacío = models\detector\best.pt (el que viaja con el código).
DETECTOR_WEIGHTS=
# Carpeta del dataset, solo para los scripts de training/. Vacío = ..\dataset, junto a la carpeta del proyecto.
SMART_SHRIMP_DATA_DIR=
